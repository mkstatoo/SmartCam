# کپی کنید به .env و مقدارها را پر کنید. این فایل را در گیت نگذارید.
# تولید: openssl rand -hex 32
DC_SECRET_KEY=
DC_ADMIN_PASSWORD=
DC_PACKAGE_NAME=ir.detective.detective_camera
DC_TRUST_PROXY=true
DC_COOKIE_SECURE=true

# توکن‌های API فروشگاه‌ها (برای تأیید خرید)
DC_BAZAAR_ACCESS_TOKEN=
DC_MYKET_ACCESS_TOKEN=

# محصولات: شناسه در پنل فروشگاه -> مدت به روز (null = دائمی)
DC_PRODUCTS={"pro_lifetime": null}

# محدودیت‌ها (بدون آپدیت اپ قابل تغییر)
DC_FREE_MAX_CAMERAS=2
DC_FREE_MAX_DEVICES=2
DC_PRO_MAX_DEVICES=4
DC_FREE_MAX_EVENTS=20
DC_OFFLINE_GRACE_DAYS=30
